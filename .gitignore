db/*.sqlite-shm
db/*.db
# New clean database lives under data/ (override with DEPOT_DB_PATH).
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/*.db
*.sqlite-wal
*.sqlite-shm

