{
  "name": "depot-management",
  "version": "0.2.0",
  "description": "Depot Management — clean rebuild: Electron desktop now, browser+server later. Browser-compatible frontend + Node application/API layer + SQLite (migrated, transactional, repository-isolated).",
  "type": "commonjs",
  "main": "src/infrastructure/electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "db:integrity": "node scripts/integrity-check.js",
    "import:source": "node scripts/import-source.js",
    "export:data": "node scripts/export-data.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "electron": "^44.4.5"
  }
}
